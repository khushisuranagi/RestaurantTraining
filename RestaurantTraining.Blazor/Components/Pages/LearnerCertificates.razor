@page "/learner/certificates"
@using RestaurantTraining.Blazor.Models
@using RestaurantTraining.Blazor.Services
@using RestaurantTraining.Blazor.Services.LearnerDashboardManagement
@inject ILearnerDashboardService LearnerDashboardService
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>My Certificates</PageTitle>

<div class="certs-page">

    <p class="eyebrow">MY ACHIEVEMENTS</p>
    <h1>Certificates</h1>
    <p class="certs-sub">Certificates you've earned by passing module quizzes.</p>

    @if (isLoading)
    {
        <p>Loading your certificates...</p>
    }
    else if (certificates.Count == 0)
    {
        <div class="empty-state">
            <h3>No certificates yet</h3>
            <p>Complete a module and pass its quiz to earn your first certificate.</p>
        </div>
    }
    else
    {
        @foreach (var cert in certificates)
        {
            <div class="cert-card">
                <div class="cert-frame">

                    <div class="cert-brand">
                        <svg class="cert-logo-mark" viewBox="0 0 32 32">
                            <circle cx="16" cy="16" r="15" fill="currentColor" />
                            <circle cx="16" cy="16" r="8.5" fill="none" stroke="#ffffff" stroke-width="2" />
                            <circle cx="16" cy="16" r="3" fill="#ffffff" />
                        </svg>
                        <span class="cert-brand-text">
                            <span class="cert-brand-name">Copperleaf</span>
                            <span class="cert-brand-sub">RESTAURANT &amp; HOSPITALITY</span>
                        </span>
                    </div>

                    <p class="cert-eyebrow">CERTIFICATE OF COMPLETION</p>
                    <div class="cert-underline"></div>

                    <p class="cert-line">This certifies that</p>
                    <p class="cert-name">@cert.LearnerName</p>

                    <p class="cert-line">has successfully completed the training module</p>
                    <p class="cert-module">@cert.ModuleName</p>

                    @if (cert.ScorePercent is not null)
                    {
                        <p class="cert-line">with a final score of <strong>@cert.ScorePercent%</strong></p>
                    }

                    <svg class="cert-medal" viewBox="0 0 48 64" fill="none"    
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 32 L14 60 L22 53" />
                        <path d="M29 32 L34 60 L26 53" />
                        <circle cx="24" cy="22" r="15" />
                        <polygon points="24,15 25.76,19.57 30.66,19.84 26.85,22.93 28.11,27.66 24,25 19.89,27.66 21.15,22.93 17.34,19.84 22.24,19.57"
                                 fill="currentColor" stroke="none" />
                    </svg>

                    <p class="cert-foot">@cert.CertificateNumber · Issued @cert.IssuedDate.ToString("MMM d, yyyy")</p>

                </div>
            </div>
        }
    }

</div>

@code {
    private List<LearnerCertificateModel> certificates = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn || AuthState.Role == "Content Creator") { Navigation.NavigateTo("/login"); return; }
        try { certificates = await LearnerDashboardService.GetCertificatesAsync(); }
        finally { isLoading = false; }
    }
}
