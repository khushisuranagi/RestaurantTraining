@page "/learning-modules"
@using RestaurantTraining.Web.Models
@using RestaurantTraining.Web.Services
@using RestaurantTraining.Web.Services.LearnerDashboardManagement
@inject ILearnerDashboardService LearnerDashboardService
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Learning Modules</PageTitle>

<div class="modules-list-page">

    <p class="eyebrow">MY LEARNING</p>
    <h1>Learning Modules</h1>

    <div class="module-search">
        <span class="search-icon">⌕</span>
        <input type="text"
               placeholder="Search modules..."
               @bind="searchText"
               @bind:event="oninput" />
    </div>

    @if (isLoading)
    {
        <p>Loading your modules...</p>
    }
    else
    {
        var filtered = string.IsNullOrWhiteSpace(searchText)
            ? modules
            : modules.Where(MatchesSearch).ToList();

        var pending = filtered.Where(m => m.HasStarted && !m.IsCompleted).ToList();
        var assigned = filtered.Where(m => !m.HasStarted).ToList();
        var completed = filtered.Where(m => m.IsCompleted).ToList();

        <div class="tab-bar">
            <button class="tab-btn @(activeTab == Tab.InProgress ? "active" : "")"
                    @onclick="() => activeTab = Tab.InProgress">
                In Progress <span class="count">@pending.Count</span>
            </button>
            <button class="tab-btn @(activeTab == Tab.Assigned ? "active" : "")"
                    @onclick="() => activeTab = Tab.Assigned">
                Assigned Modules <span class="count">@assigned.Count</span>
            </button>
            <button class="tab-btn @(activeTab == Tab.Completed ? "active" : "")"
                    @onclick="() => activeTab = Tab.Completed">
                Completed <span class="count">@completed.Count</span>
            </button>
        </div>

        @if (activeTab == Tab.InProgress)
        {
            @if (pending.Count == 0)
            {
                <div class="empty-row">Nothing in progress right now.</div>
            }
            else
            {
                <div class="mod-card-grid">
                    @foreach (var m in pending)
                    {
                        <div class="mod-card" @onclick="() => Open(m.ModuleId)">
                            @RenderThumb(m, "📖")
                            <div class="mod-card-body">
                                <h3>@m.ModuleName</h3>
                                <div class="progress-track"><div class="progress-fill" style="width:@(m.ProgressPercent)%"></div></div>
                                @if (m.QuizPassed)
                                {
                                    <span class="mod-stage-badge"> Quiz passed </span>
                                    <span class="mod-stage-badge">Practice scenario pending</span>
                                }
                                <div class="mod-card-footer">
                                    <span class="mod-percent">@m.ProgressPercent% complete</span>
                                    <button class="mod-btn continue" @onclick:stopPropagation="true" @onclick="() => Open(m.ModuleId)">Continue →</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (activeTab == Tab.Assigned)
        {
            @if (assigned.Count == 0)
            {
                <div class="empty-row">No new modules to start.</div>
            }
            else
            {
                <div class="mod-card-grid">
                    @foreach (var m in assigned)
                    {
                        <div class="mod-card" @onclick="() => Open(m.ModuleId)">
                            @RenderThumb(m, "📗")
                            <div class="mod-card-body">
                                <h3>@m.ModuleName</h3>
                                <p class="mod-desc">@(string.IsNullOrWhiteSpace(m.Description) ? "Ready to start." : m.Description)</p>
                                <div class="mod-card-footer">
                                    <button class="mod-btn start" @onclick:stopPropagation="true" @onclick="() => Open(m.ModuleId)">Start</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (activeTab == Tab.Completed)
        {
            @if (completed.Count == 0)
            {
                <div class="empty-row">No completed modules yet.</div>
            }
            else
            {
                <div class="mod-card-grid">
                    @foreach (var m in completed)
                    {
                        <div class="mod-card" @onclick="() => Open(m.ModuleId)">
                            @RenderThumb(m, "✅")
                            <div class="mod-card-body">
                                <h3>@m.ModuleName</h3>
                                <div class="mod-card-footer">
                                    <span class="mod-done">Completed</span>
                                    <button class="mod-btn review" @onclick:stopPropagation="true" @onclick="() => Open(m.ModuleId)">Review</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }

</div>

@code {
    private enum Tab { InProgress, Assigned, Completed }

    private List<LearnerModuleOverviewModel> modules = [];
    private bool isLoading = true;
    private Tab activeTab = Tab.InProgress;
    private string searchText = string.Empty;

    // Matches a module by name or description (case-insensitive).
    private bool MatchesSearch(LearnerModuleOverviewModel m)
    {
        var q = searchText.Trim();
        return m.ModuleName.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(m.Description)
                && m.Description.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn || AuthState.Role == "Content Creator") { Navigation.NavigateTo("/login"); return; }
        try
        {
            modules = await LearnerDashboardService.GetModulesOverviewAsync();

            var hasPending = modules.Any(m => m.HasStarted && !m.IsCompleted);
            var hasAssigned = modules.Any(m => !m.HasStarted);

            activeTab = hasPending ? Tab.InProgress
                : hasAssigned ? Tab.Assigned
                : Tab.Completed;
        }
        finally { isLoading = false; }
    }

    private void Open(int moduleId) => Navigation.NavigateTo($"/learning-modules/{moduleId}");

    private RenderFragment RenderThumb(LearnerModuleOverviewModel m, string fallbackEmoji) => builder =>
    {
        if (!string.IsNullOrWhiteSpace(m.CoverImageData) && !string.IsNullOrWhiteSpace(m.CoverImageContentType))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "class", "mod-card-thumb-img");
            builder.AddAttribute(2, "src", $"data:{m.CoverImageContentType};base64,{m.CoverImageData}");
            builder.AddAttribute(3, "alt", m.ModuleName);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "mod-card-thumb-fallback");
            builder.AddContent(2, fallbackEmoji);
            builder.CloseElement();
        }
    };
}