@page "/learning-modules/{ModuleId:int}"
@using RestaurantTraining.Blazor.Services.LearnerDashboardManagement
@using RestaurantTraining.Domain.Enums
@inject ILearnerDashboardService LearnerDashboardService
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Learning Module</PageTitle>

<div class="learning-module-page">
    <button class="back-button" @onclick='() => Navigation.NavigateTo("/learning-modules")'>← Back to Learning</button>

    @if (isLoading)
    {
        <p>Loading your lessons...</p>
    }
    else if (module is null)
    {
        <div class="empty-state"><h2>Module unavailable</h2><p>This module is no longer assigned to your role.</p></div>
    }
    else
    {
        <p class="eyebrow">TRAINING MODULE</p>
        <h1>@module.ModuleName</h1>
        @if (totalPoints > 0)
        {
            <p class="points-badge">⭐ @totalPoints points</p>
        }
        <p class="module-description">@module.Description</p>

        @if (module.Lessons.Count == 0)
        {
            <div class="empty-state"><p>There are no active lessons in this module yet.</p></div>
        }
        else
        {
            var lesson = module.Lessons[currentIndex];
            var total = module.Lessons.Count;
            var completed = module.Lessons.Count(l => l.IsCompleted);
            var percent = total > 0 ? (int)Math.Round(100.0 * completed / total) : 0;

            <div class="lesson-progress">
                <div class="lesson-progress-top">
                    <span>Lesson @(currentIndex + 1) of @total</span>
                    <span>@completed of @total completed</span>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width:@(percent)%"></div></div>
            </div>

            <section class="lesson-card">
                <h2>@lesson.LessonTitle @(lesson.IsCompleted ? "✓" : "")</h2>
                @if (!string.IsNullOrWhiteSpace(lesson.Description)) { <p>@lesson.Description</p> }

                @if (lesson.Resources.Count == 0)
                {
                    <p class="muted">Lesson material will be added soon.</p>
                }
                else
                {
                    @foreach (var resource in lesson.Resources)
                    {
                        <div class="learning-resource">

                            
                            @if (resource.ResourceType == (int)ResourceType.Video)
                            {
                                var embedUrl = GetYouTubeEmbedUrl(resource.ResourceUrl);
                                @if (embedUrl is not null)
                                  { <iframe class="resource-video" src="@embedUrl" title="@lesson.LessonTitle video" allowfullscreen></iframe> 
                                  }
                                else { <a href="@resource.ResourceUrl" target="_blank" rel="noopener noreferrer">Watch video →</a> }
                            }
                            else if (resource.ResourceType == (int)ResourceType.Image && HasFile(resource))
                            {
                                <img class="resource-image" src="@GetFileDataUrl(resource)" alt="@resource.FileName" />
                            }
                            else if (resource.ResourceType == (int)ResourceType.Document && HasFile(resource))
                            {
                                @if (IsPdf(resource.ContentType))
                                {
                                    <iframe class="resource-pdf" src="@GetFileDataUrl(resource)" title="@resource.FileName"></iframe>
                                }
                                else if (IsDocx(resource.ContentType))
                                {
                                    <div id="docx-preview-@resource.ResourceId" class="docx-preview">Loading document...</div>
                                }
                                else if (IsPlainText(resource.ContentType))
                                {
                                    <pre class="text-preview">@GetPlainTextContent(resource)</pre>
                                }
                                else
                                {
                                    <a class="resource-link" href="@GetFileDataUrl(resource)" download="@resource.FileName">
                                        📄 Download @resource.FileName
                                    </a>
                                }
                            }
                            else if (resource.ResourceType == (int)ResourceType.Article && !string.IsNullOrWhiteSpace(resource.ResourceUrl))
                            {
                                @if (!articlePreviews.TryGetValue(resource.ResourceId, out var preview) || preview is null)
                                {
                                    <a href="@resource.ResourceUrl" target="_blank" rel="noopener noreferrer">Open article →</a>
                                }
                                else if (preview.Success)
                                {
                                    <a class="article-preview-card" href="@resource.ResourceUrl" target="_blank" rel="noopener noreferrer">
                                        @if (!string.IsNullOrWhiteSpace(preview.ImageUrl))
                                        {
                                            <img class="article-preview-image" src="@preview.ImageUrl" alt="@preview.Title" />
                                        }
                                        <div class="article-preview-text">
                                            <span class="article-preview-site">@(string.IsNullOrWhiteSpace(preview.SiteName) ? new Uri(resource.ResourceUrl).Host : preview.SiteName)</span>
                                            <strong class="article-preview-title">@preview.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(preview.Description))
                                            {
                                                <p class="article-preview-desc">@preview.Description</p>
                                            }
                                        </div>
                                    </a>
                                }
                                else
                                {
                                    <a href="@resource.ResourceUrl" target="_blank" rel="noopener noreferrer">Open article →</a>
                                }
                            }
                            @* ---- Optional AI summary ---- *@
                            <div class="resource-summary">
                                @if (summaries.TryGetValue(resource.ResourceId, out var summ) && summ is not null)
                                {
                                    <div class="summary-box">
                                        <p class="summary-title">✨ AI summary</p>
                                        <p class="summary-text">@summ</p>
                                    </div>
                                }
                                else
                                {
                                    <button class="summary-btn"
                                            disabled="@summarizing.Contains(resource.ResourceId)"
                                            @onclick="() => LoadSummary(resource.ResourceId)">
                                        @(summarizing.Contains(resource.ResourceId) ? "Summarising..." : "Summarise with AI")
                                    </button>
                                    @if (summaryErrors.Contains(resource.ResourceId))
                                    {
                                        <p class="summary-error">Couldn't generate a summary. Please try again.</p>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </section>

            @* ---- AI question(s) for this lesson's resource(s) ---- *@
            @foreach (var res in lesson.Resources)
            {
                @if (questionsLoaded.Contains(res.ResourceId) && resourceQuestions[res.ResourceId] is { } q)
                {
                    <section class="mcq-card">
                        <p class="mcq-eyebrow">QUICK CHECK</p>
                        <p class="mcq-question">@q.QuestionText</p>

                        @if (answeredCorrectly.Contains(res.ResourceId))
                        {
                            <p class="mcq-correct">✓ Correct — you can continue.</p>
                            @if (answerResults.TryGetValue(res.ResourceId, out var okRes) && okRes is not null && !string.IsNullOrWhiteSpace(okRes.Explanation))
                            {
                                <p class="mcq-explanation">@okRes.Explanation</p>
                            }
                        }
                        else
                        {
                            <div class="mcq-options">
                                @foreach (var opt in q.Options)
                                {
                                    <label class="mcq-option">
                                        <input type="radio" name="mcq-@res.ResourceId"
                                               checked="@(selectedOptions.GetValueOrDefault(res.ResourceId) == opt.OptionId)"
                                               @onchange="() => selectedOptions[res.ResourceId] = opt.OptionId" />
                                        <span>@opt.OptionText</span>
                                    </label>
                                }
                            </div>

                            @if (answerResults.TryGetValue(res.ResourceId, out var wrongRes) && wrongRes is not null && !wrongRes.IsCorrect)
                            {
                                <p class="mcq-wrong">✗ Not quite — try again.</p>
                            }

                            <button class="mcq-submit"
                                    disabled="@(submitting.Contains(res.ResourceId) || selectedOptions.GetValueOrDefault(res.ResourceId) is null)"
                                    @onclick="() => SubmitResourceAnswer(res.ResourceId)">
                                @(submitting.Contains(res.ResourceId) ? "Checking..." : "Submit answer")
                            </button>
                        }
                    </section>
                }
            }

            <div class="lesson-nav">
                <button class="lesson-prev" disabled="@(currentIndex == 0)" @onclick="Previous">← Previous</button>

                @if (currentIndex < total - 1)
                {
                    <button class="lesson-next" disabled="@(isSaving || !CanProceed())" @onclick="Next">
                        @(isSaving ? "Saving..." : "Next →")
                    </button>
                }
                else
                {
                    <button class="lesson-quiz" disabled="@(isSaving || !CanProceed())" @onclick="TakeQuiz">
                        @(isSaving ? "Saving..." : "Take Quiz →")
                    </button>
                }
            </div>

            @if (!CanProceed())
            {
                <p class="gate-hint">Answer the question above correctly to continue.</p>
            }
        }
    }
</div>

@code {
    [Parameter] public int ModuleId { get; set; }
    private LearnerModuleContentModel? module;
    private bool isLoading = true;
    private bool isSaving;
    private int currentIndex;

    // ---- AI question (MCQ) state, keyed by resourceId ----
    private HashSet<int> questionsLoaded = new();
    private Dictionary<int, ResourceQuestionModel?> resourceQuestions = new();
    private Dictionary<int, int?> selectedOptions = new();
    private Dictionary<int, ResourceAnswerResultModel?> answerResults = new();
    private HashSet<int> answeredCorrectly = new();
    private HashSet<int> submitting = new();
    private int totalPoints;

    // Load the MCQ for each resource in the current lesson (once each).
    private async Task LoadQuestionsForCurrentLesson()
    {
        if (module is null || module.Lessons.Count == 0) return;

        var lesson = module.Lessons[currentIndex];
        foreach (var r in lesson.Resources)
        {
            if (questionsLoaded.Contains(r.ResourceId)) continue;

            var q = await LearnerDashboardService.GetResourceQuestionAsync(r.ResourceId);
            resourceQuestions[r.ResourceId] = q;
            questionsLoaded.Add(r.ResourceId);

            if (q is not null && q.AlreadyAnsweredCorrectly)
                answeredCorrectly.Add(r.ResourceId);
        }
        StateHasChanged();
    }

    // Can the learner move on? Only once every loaded question is answered right.
    private bool CanProceed()
    {
        if (module is null || module.Lessons.Count == 0) return true;

        var lesson = module.Lessons[currentIndex];
        foreach (var r in lesson.Resources)
        {
            if (!questionsLoaded.Contains(r.ResourceId)) return false;   // still loading
            var q = resourceQuestions[r.ResourceId];
            if (q is not null && !answeredCorrectly.Contains(r.ResourceId)) return false;
        }
        return true;
    }

    private async Task SubmitResourceAnswer(int resourceId)
    {
        if (!selectedOptions.TryGetValue(resourceId, out var optId) || optId is null) return;

        submitting.Add(resourceId);
        try
        {
            var result = await LearnerDashboardService.SubmitResourceAnswerAsync(resourceId, optId.Value);
            answerResults[resourceId] = result;

            if (result is not null)
            {
                totalPoints = result.TotalPoints;
                if (result.IsCorrect) answeredCorrectly.Add(resourceId);
            }
        }
        finally { submitting.Remove(resourceId); }
    }

    // ---- AI summary state ----
    private Dictionary<int, string?> summaries = new();
    private HashSet<int> summarizing = new();
    private HashSet<int> summaryErrors = new();

    private async Task LoadSummary(int resourceId)
    {
        summarizing.Add(resourceId);
        summaryErrors.Remove(resourceId);
        try
        {
            var text = await LearnerDashboardService.GetResourceSummaryAsync(resourceId);
            if (string.IsNullOrWhiteSpace(text))
                summaryErrors.Add(resourceId);
            else
                summaries[resourceId] = text;
        }
        catch
        {
            summaryErrors.Add(resourceId);
        }
        finally { summarizing.Remove(resourceId); }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn || AuthState.Role == "Content Creator") { Navigation.NavigateTo("/login"); return; }
        try
        {
            await LearnerDashboardService.RecordModuleOpenedAsync(ModuleId);
            module = await LearnerDashboardService.GetAssignedModuleAsync(ModuleId);

            if (module is not null && module.Lessons.Count > 0)
            {
                var firstIncomplete = module.Lessons.FindIndex(l => !l.IsCompleted);
                currentIndex = firstIncomplete >= 0 ? firstIncomplete : 0;
                await LoadArticlePreviewsForCurrentLesson();
                await LoadQuestionsForCurrentLesson();
            }
        }
        finally { isLoading = false; }
    }


    private async Task LoadArticlePreviewsForCurrentLesson()
    {
        if (module is null) return;

        var lesson = module.Lessons[currentIndex];
        var articleResources = lesson.Resources
            .Where(r => r.ResourceType == (int)ResourceType.Article
                && !string.IsNullOrWhiteSpace(r.ResourceUrl))
            .ToList();

        foreach (var resource in articleResources)
        {
            if (articlePreviews.ContainsKey(resource.ResourceId)) continue;

            var preview = await LearnerDashboardService.GetArticlePreviewAsync(resource.ResourceUrl);
            articlePreviews[resource.ResourceId] = preview;
        }
    }




    private async Task MarkCurrentComplete()
    {
        if (module is null) return;
        var lesson = module.Lessons[currentIndex];

        if (lesson.IsCompleted) return;

        isSaving = true;
        try
        {
            var ok = await LearnerDashboardService.MarkLessonCompleteAsync(lesson.LessonId);
            if (ok) lesson.IsCompleted = true;
        }
        finally { isSaving = false; }
    }

    private async Task Previous()
    {
        if (currentIndex > 0) currentIndex--;
        await LoadArticlePreviewsForCurrentLesson();
        await LoadQuestionsForCurrentLesson();
    }

    private async Task Next()
    {
        await MarkCurrentComplete();
        if (module is not null && currentIndex < module.Lessons.Count - 1) currentIndex++;
        await LoadArticlePreviewsForCurrentLesson();
        await LoadQuestionsForCurrentLesson();
    }

    private async Task TakeQuiz()
    {
        await MarkCurrentComplete();
        Navigation.NavigateTo($"/learner/quiz/{ModuleId}");
    }

    private static bool HasFile(LearnerLessonResourceModel r) => !string.IsNullOrWhiteSpace(r.FileData) && !string.IsNullOrWhiteSpace(r.ContentType);
    private static string GetFileDataUrl(LearnerLessonResourceModel r) => $"data:{r.ContentType};base64,{r.FileData}";       //base64
    private static string? GetYouTubeEmbedUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;
        var id = url.Contains("youtu.be/") ? url.Split("youtu.be/")[1] : url.Contains("watch?v=") ? url.Split("watch?v=")[1] : string.Empty;
        id = id.Split('?', '&')[0];
        return string.IsNullOrWhiteSpace(id) ? null : $"https://www.youtube.com/embed/{id}";
    }

    private Dictionary<int, ArticlePreviewModel?> articlePreviews = new();

    private async Task LoadArticlePreviewIfNeeded(LearnerLessonResourceModel resource)
    {
        if (articlePreviews.ContainsKey(resource.ResourceId)) return;

        articlePreviews[resource.ResourceId] = null; // mark as loading
        var preview = await LearnerDashboardService.GetArticlePreviewAsync(resource.ResourceUrl);
        articlePreviews[resource.ResourceId] = preview;
        StateHasChanged();
    }

    private static string GetPlainTextContent(LearnerLessonResourceModel r)
    {
        if (string.IsNullOrWhiteSpace(r.FileData)) return string.Empty;
        var bytes = Convert.FromBase64String(r.FileData);
        return System.Text.Encoding.UTF8.GetString(bytes);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (module is null || module.Lessons.Count == 0) return;

        var lesson = module.Lessons[currentIndex];
        var docxResources = lesson.Resources
            .Where(r => r.ResourceType == (int)ResourceType.Document
                && HasFile(r) && IsDocx(r.ContentType))
            .ToList();

        foreach (var resource in docxResources)
        {
            if (docxRendered.Contains(resource.ResourceId)) continue;

            docxRendered.Add(resource.ResourceId);
            await JS.InvokeVoidAsync("renderDocxPreview",
                $"docx-preview-{resource.ResourceId}", resource.FileData);
        }
    }

    private static bool IsPdf(string? contentType) =>
    contentType == "application/pdf";

    private static bool IsDocx(string? contentType) =>
        contentType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document";

    private static bool IsOldDoc(string? contentType) =>
        contentType == "application/msword";

    private static bool IsPlainText(string? contentType) =>
        contentType == "text/plain";

    private HashSet<int> docxRendered = new();

}
