@page "/lessons/{LessonId:int}"

@using RestaurantTraining.Web.Models
@using RestaurantTraining.Web.Services.LessonManagement
@using RestaurantTraining.Domain.Enums
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Lesson</PageTitle>

<div class="modules-page">

    <div class="modules-header">

        <div>

            <button class="back-button"
                    @onclick="BackToLessons">
                ← Back to Lessons
            </button>

            <p class="eyebrow">LESSON</p>

            @if (lesson != null)
            {
                <h1>@lesson.LessonTitle</h1>

                <p>
                    @(string.IsNullOrWhiteSpace(lesson.Description)
                        ? "Manage resources for this lesson."
                        : lesson.Description)
                </p>
            }

        </div>

      

    </div>


    @if (isLoading)
    {
        <div class="loading-state">
            Loading lesson...
        </div>
    }
    else if (lesson == null)
    {
        <div class="empty-state">
            <h3>Lesson not found</h3>
        </div>
    }
    else
    {
        @if (resources.Count == 0)
        {
            <div class="empty-state">
                <h3>No resources yet</h3>
                <p>Add a resource to this lesson.</p>
            </div>
        }
        else
        {
            @foreach (var resource in resources
    .Where(x => x.LessonId == lesson.LessonId)
    .OrderBy(x => x.SortOrder))
            {
                <div class="resource-card">

                    <div class="resource-type-label">
                       @*  @resource.ResourceType.ToString().ToUpper() *@
                    </div>


                    @if (resource.ResourceType == ResourceType.Image)
                    {
                        @if (!string.IsNullOrWhiteSpace(resource.FileData))
                        {
                            <div class="image-resource">
                                <img src="@GetFileDataUrl(resource)"
                                     alt="@resource.FileName"
                                     class="resource-image" />
                            </div>
                        }
                        else
                        {
                            <div class="resource-fallback">
                                Image could not be loaded.
                            </div>
                        }
                    }


                    else if (resource.ResourceType == ResourceType.Document)
                    {
                        @if (!string.IsNullOrWhiteSpace(resource.FileData))
                        {
                            @if (IsPdf(resource.ContentType))
                            {
                                <div class="pdf-resource">
                                    <iframe src="@GetFileDataUrl(resource)" class="resource-pdf" title="@resource.FileName"></iframe>
                                </div>
                            }
                            else if (IsDocx(resource.ContentType))
                            {
                                <div class="pdf-resource">
                                    <div id="docx-preview-@resource.ResourceId" class="docx-preview">Loading document...</div>
                                </div>
                            }
                            else if (IsPlainText(resource.ContentType))
                            {
                                <pre class="text-preview">@GetPlainTextContent(resource)</pre>
                            }
                            else
                            {
                                <a class="resource-link" href="@GetFileDataUrl(resource)" download="@resource.FileName">
                                    📄 Download @resource.FileName
                                </a>
                            }
                        }
                        else
                        {
                            <div class="resource-fallback">
                                File could not be loaded.
                            </div>
                        }
                    }


                    else if (resource.ResourceType == ResourceType.Article)
                    {
                        <div class="article-resource">
                            @if (!articlePreviews.TryGetValue(resource.ResourceId, out var preview) || preview is null)
                            {
                                <a href="@resource.ResourceUrl" target="_blank" rel="noopener noreferrer" class="resource-link">
                                    Open Article →
                                </a>
                            }
                            else if (preview.Success)
                            {
                                <a class="article-preview-card" href="@resource.ResourceUrl" target="_blank" rel="noopener noreferrer">
                                    @if (!string.IsNullOrWhiteSpace(preview.ImageUrl))
                                    {
                                        <img class="article-preview-image" src="@preview.ImageUrl" alt="@preview.Title" />
                                    }
                                    <div class="article-preview-text">
                                        <span class="article-preview-site">@(string.IsNullOrWhiteSpace(preview.SiteName) ? new Uri(resource.ResourceUrl).Host : preview.SiteName)</span>
                                        <strong class="article-preview-title">@preview.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(preview.Description))
                                        {
                                            <p class="article-preview-desc">@preview.Description</p>
                                        }
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a href="@resource.ResourceUrl" target="_blank" rel="noopener noreferrer" class="resource-link">
                                    Open Article →
                                </a>
                            }
                        </div>
                    }


                    else if (resource.ResourceType == ResourceType.Video)
                    {
                        var embedUrl =
                            GetYouTubeEmbedUrl(resource.ResourceUrl);

                        @if (embedUrl != null)
                        {
                            <div class="video-resource">

                                <iframe src="@embedUrl"
                                        class="resource-video"
                                        title="Video resource"
                                        allowfullscreen>
                                </iframe>

                            </div>
                        }
                        else
                        {
                            <div class="article-resource">

                                <a href="@resource.ResourceUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="resource-link">

                                    Open Video →

                                </a>

                            </div>
                        }
                    }


                    @if (!string.IsNullOrWhiteSpace(resource.ContentText))
                    {
                        <p class="resource-description">
                            @resource.ContentText
                        </p>
                    }


                    <div class="resource-actions">

                        <button class="edit-button"
                                @onclick="() => OpenEditResourceModal(resource)">
                            ✏️ Edit
                        </button>

                        <button class="delete-button"
                                @onclick="() => DeleteResource(resource)">
                            🗑️ Delete
                        </button>

                    </div>

                </div>
            }
        }
    }

</div>


@if (showResourceModal)
{
    <div class="modal-overlay">

        <div class="module-form">

            <div class="form-header">

                <div>

                    <h2>
                        @(editingResourceId == 0
                            ? "Add Resource"
                            : "Edit Resource")
                    </h2>

                    <p>
                        @(editingResourceId == 0
                            ? "Add a resource to this lesson."
                            : "Update this resource for the lesson.")
                    </p>

                </div>

                <button class="close-button"
                        @onclick="CloseResourceModal">
                    ×
                </button>

            </div>


            @if (!string.IsNullOrWhiteSpace(saveError))
            {
                <div class="form-error">
                    @saveError
                </div>
            }


            <div class="form-group">

                <label>Resource Type</label>

                <select @bind="resourceType">

                    @foreach (var type in Enum.GetValues<ResourceType>())
                    {
                        <option value="@type">
                            @type
                        </option>
                    }

                </select>

            </div>


            @if (resourceType == ResourceType.Video)
            {
                <div class="form-group">

                    <label>Video URL</label>

                    <input type="url"
                           @bind="resourceUrl"
                           placeholder="Paste video URL" />

                </div>
            }


            @if (resourceType == ResourceType.Article)
            {
                <div class="form-group">

                    <label>Article URL</label>

                    <input type="url"
                           @bind="resourceUrl"
                           placeholder="Paste article URL" />

                </div>
            }


            @if (resourceType == ResourceType.Document)
            {
                <div class="form-group">

                    <label>Text File</label>

                    <InputFile accept=".pdf,.doc,.docx,.txt,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain"
                               OnChange="HandleFileSelected" />

                    @if (editingResourceId != 0)
                    {
                        <p class="field-hint">
                            Leave empty to keep the current text file.
                        </p>
                    }

                </div>
            }


            @if (resourceType == ResourceType.Image)
            {
                <div class="form-group">

                    <label>Image File</label>

                    <InputFile accept="image/*"
                               OnChange="HandleFileSelected" />

                    @if (editingResourceId != 0)
                    {
                        <p class="field-hint">
                            Leave empty to keep the current image.
                        </p>
                    }

                </div>
            }


            <div class="form-group">

                <label>Content / Description</label>

                <textarea @bind="resourceContent"
                          placeholder="Enter information or description for this resource">
                </textarea>

            </div>


            <div class="form-group">

                <label>Sort Order</label>

                <input type="number"
                       @bind="resourceSortOrder" />

            </div>


            <div class="form-actions">

                <button class="cancel-button"
                        @onclick="CloseResourceModal">
                    Cancel
                </button>

                <button class="save-button"
                        @onclick="SaveResource"
                        disabled="@isSaving">

                    @(isSaving ? "Saving..." : "Save")

                </button>

            </div>

        </div>

    </div>
}