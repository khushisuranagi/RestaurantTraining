@page "/learner/quiz/{ModuleId:int}"

@using RestaurantTraining.Blazor.Models
@using RestaurantTraining.Blazor.Services
@using RestaurantTraining.Blazor.Services.LearnerQuizManagement
@using RestaurantTraining.Domain.Enums

<PageTitle>Quiz</PageTitle>

<div class="learner-quiz-page">

    <button class="back-button" @onclick='() => Navigation.NavigateTo($"/learning-modules/{ModuleId}")'>
        ← Back to lessons
    </button>

    @if (isLoading)
    {
        <p>Loading quiz...</p>
    }
    else if (quiz is null || quiz.Questions.Count == 0)
    {
        <div class="empty-state">
            <h2>No quiz available</h2>
            <p>This module doesn't have a quiz yet.</p>
        </div>
    }
    else if (result is null)
    {
        <p class="eyebrow">MODULE QUIZ</p>

        <h1>Answer all questions</h1>

        @foreach (var (q, index) in quiz.Questions.Select((q, i) => (q, i)))
        {
            <section class="quiz-question">

                <h3>
                    @(index + 1). @q.QuestionText
                    <span class="q-marks">
                        (@q.Marks mark@(q.Marks == 1 ? "" : "s"))
                    </span>
                </h3>

                @if (q.QuestionType == (int)QuestionType.FillInTheBlank)
                {
                    <input class="fill-input"
                           type="text"
                           placeholder="Type your answer"
                           @bind="textAnswers[q.QuestionId]" />
                }
                else if (q.QuestionType == (int)QuestionType.TrueFalse)
                {
                    @foreach (var o in q.Options)
                    {
                        <label class="opt-row">

                            <input type="radio"
                                   name="q@(q.QuestionId)"
                                   checked="@selected[q.QuestionId].Contains(o.OptionId)"
                                   @onchange="() => SelectSingle(q.QuestionId, o.OptionId)" />

                            @o.OptionText

                        </label>
                    }
                }
                else
                {
                    @foreach (var o in q.Options)
                    {
                        <label class="opt-row">

                            <input type="checkbox"
                                   checked="@selected[q.QuestionId].Contains(o.OptionId)"
                                   @onchange="e => ToggleOption(q.QuestionId, o.OptionId, (bool)e.Value!)" />

                            @o.OptionText

                        </label>
                    }
                }

            </section>
        }

        <button class="submit-quiz"
                disabled="@isSubmitting"
                @onclick="Submit">

            @(isSubmitting ? "Submitting..." : "Submit Quiz")

        </button>
    }
    else
    {
        @if (result.Passed)
        {
            <h2 class="pass-heading">
                🎉 You passed with @result.Percentage%!
            </h2>

            <div class="cert-card">

                <div class="cert-frame">

                    <div class="cert-brand">

                        <svg class="cert-logo-mark" viewBox="0 0 32 32">
                            <circle cx="16" cy="16" r="15" fill="currentColor" />
                            <circle cx="16"
                                    cy="16"
                                    r="8.5"
                                    fill="none"
                                    stroke="#ffffff"
                                    stroke-width="2" />
                            <circle cx="16" cy="16" r="3" fill="#ffffff" />
                        </svg>

                        <span class="cert-brand-text">

                            <span class="cert-brand-name">
                                Copperleaf
                            </span>

                            <span class="cert-brand-sub">
                                RESTAURANT &amp; HOSPITALITY
                            </span>

                        </span>

                    </div>

                    <p class="cert-eyebrow">
                        CERTIFICATE OF COMPLETION
                    </p>

                    <div class="cert-underline"></div>

                    <p class="cert-line">
                        This certifies that
                    </p>

                    <p class="cert-name">
                        @AuthState.FullName
                    </p>

                    <p class="cert-line">
                        has successfully completed the training module
                    </p>

                    <p class="cert-module">
                        @result.ModuleName
                    </p>

                    <p class="cert-line">
                        with a final score of <strong>@result.Percentage%</strong>
                    </p>

                    <svg class="cert-medal"
                         viewBox="0 0 48 64"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M19 32 L14 60 L22 53" />
                        <path d="M29 32 L34 60 L26 53" />

                        <circle cx="24" cy="22" r="15" />

                        <polygon points="24,15 25.76,19.57 30.66,19.84 26.85,22.93 28.11,27.66 24,25 19.89,27.66 21.15,22.93 17.34,19.84 22.24,19.57"
                                 fill="currentColor"
                                 stroke="none" />

                    </svg>

                    @if (!string.IsNullOrWhiteSpace(result.CertificateNumber))
                    {
                        <p class="cert-foot">
                            @result.CertificateNumber
                        </p>
                    }

                </div>

            </div>

            <div class="result-actions">

                <button class="back-button"
                        @onclick='() => Navigation.NavigateTo("/learner-dashboard")'>
                    Back to dashboard
                </button>

                <button class="submit-quiz"
                        @onclick='() => Navigation.NavigateTo("/learner/certificates")'>
                    View my certificates
                </button>

            </div>
        }
        else
        {
            <div class="quiz-result failed">

                <h1>Not quite — keep going</h1>

                <p class="result-score">
                    @result.Percentage%
                    &nbsp;
                    (@result.CorrectCount of @result.TotalQuestions correct)
                </p>

                <p class="result-detail">
                    Score: @result.Score / @result.TotalMarks ·
                    Passing score: @result.PassingScore%
                </p>

                <div class="result-actions">

                    <button class="back-button"
                            @onclick='() => Navigation.NavigateTo("/learner-dashboard")'>
                        Back to dashboard
                    </button>

                    <button class="submit-quiz"
                            @onclick="Retry">
                        Try again
                    </button>

                </div>

            </div>
        }
    }

</div>