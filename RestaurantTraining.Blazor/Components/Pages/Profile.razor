@page "/profile"
@using RestaurantTraining.Web.Models
@using RestaurantTraining.Web.Services
@using RestaurantTraining.Web.Services.ProfileManagement

<PageTitle>My Profile</PageTitle>

<div class="profile-page">

    <p class="eyebrow">ACCOUNT</p>
    <h1>My Profile</h1>

    @if (isLoading)
    {
        <div class="loading-state">Loading your profile...</div>
    }
    else if (profile is null)
    {
        <div class="empty-state"><h3>Profile unavailable</h3><p>We couldn't load your details right now.</p></div>
    }
    else
    {
        <div class="profile-card">

            <div class="profile-top">
                <span class="profile-avatar-lg">@Initials(profile.FullName)</span>
                <div class="profile-top-text">
                    <h2>@profile.FullName</h2>
                    <p class="profile-role">@profile.Role</p>
                </div>

                @if (!isEditing)
                {
                    <button class="edit-btn" @onclick="StartEdit">Edit</button>
                }
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <p class="profile-message @(isSuccess ? "success" : "")">@message</p>
            }

            @if (!isEditing)
            {
                <div class="detail-grid">
                    <div class="detail"><span class="detail-label">Full name</span><span class="detail-value">@profile.FullName</span></div>
                    <div class="detail"><span class="detail-label">Email</span><span class="detail-value">@profile.Email</span></div>
                    <div class="detail"><span class="detail-label">Phone</span><span class="detail-value">@(string.IsNullOrWhiteSpace(profile.PhoneNumber) ? "—" : profile.PhoneNumber)</span></div>
                    <div class="detail"><span class="detail-label">Role</span><span class="detail-value">@profile.Role</span></div>
                    <div class="detail">
                        <span class="detail-label">Account status</span>
                        <span class="detail-value">
                            <span class="status @(profile.IsActive ? "active" : "inactive")">@(profile.IsActive ? "Active" : "Inactive")</span>
                        </span>
                    </div>
                    <div class="detail"><span class="detail-label">Member since</span><span class="detail-value">@profile.CreatedAt.ToString("MMMM d, yyyy")</span></div>
                    <div class="detail"><span class="detail-label">Last login</span><span class="detail-value">@(profile.LastLoginAt is null ? "—" : profile.LastLoginAt.Value.ToString("MMMM d, yyyy h:mm tt"))</span></div>
                </div>

                @if (isOutstanding)
                {
                    <span class="profile-award">🏆 Outstanding Performance</span>
                }
            }
            else
            {
                <div class="edit-grid">
                    <div class="form-group">
                        <label>Full name</label>
                        <input type="text" @bind="editFullName" placeholder="Enter your full name" />
                    </div>
                    <div class="form-group">
                        <label>Phone</label>
                        <input type="tel" @bind="editPhoneNumber" placeholder="Enter your phone number" />
                    </div>
                </div>

                <div class="edit-actions">
                    <button class="cancel-btn" @onclick="CancelEdit" disabled="@isSaving">Cancel</button>
                    <button class="save-btn" @onclick="SaveEdit" disabled="@isSaving">@(isSaving ? "Saving..." : "Save changes")</button>
                </div>
            }

        </div>
    }

</div>